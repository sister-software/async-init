{
	"name": "async-init",
	"version": "1.0.0",
	"description": "Async construction and disposal lifecycle primitives — the missing symbol for constructing asynchronous things.",
	"keywords": [
		"AsyncDisposable",
		"async",
		"dependency-injection",
		"disposable",
		"lifecycle",
		"registry",
		"service"
	],
	"license": "MIT",
	"author": "Teffen Ellis <teffen@sister.software>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sister-software/async-init.git"
	},
	"files": [
		"out/index.d.ts",
		"out/index.d.ts.map",
		"out/index.js",
		"out/index.js.map",
		"out/lib/**/*",
		"README.md",
		"LICENSE.md"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": "./out/lib/*.js",
		"#test/*": "./test/*.ts"
	},
	"exports": {
		"./package.json": "./package.json",
		".": "./out/index.js"
	},
	"scripts": {
		"check-types": "tsc --build .",
		"clean": "tsc -b --clean",
		"compile": "NODE_OPTIONS=\"--max-old-space-size=3000\" tsc -b",
		"lint": "run-s lint:oxlint lint:oxfmt",
		"lint:oxlint": "oxlint",
		"lint:oxfmt": "oxfmt --check .",
		"lint:fix": "run-s fix:oxlint format",
		"fix:oxlint": "oxlint --fix",
		"format": "oxfmt .",
		"test": "yarn compile && vitest",
		"test:types": "vitest run --typecheck",
		"release": "release-it"
	},
	"devDependencies": {
		"@sister.software/oxfmt-config": "^14.8.0",
		"@sister.software/oxlint-config": "^14.8.0",
		"@sister.software/tsconfig": "^14.8.0",
		"@types/node": "^26.6.6",
		"npm-run-all": "^4.1.5",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "^7.0.2006",
		"release-it": "^17.11.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	},
	"packageManager": "yarn@4.18.1",
	"release-it": {
		"npm": {
			"publish": true
		}
	}
}
